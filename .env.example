# Supabase (Project Settings → API). A anon/publishable key é pública por desenho:
# quem protege os dados é a RLS do banco. NUNCA coloque a service_role key aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL final do site (SEO, sitemap, imagem de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# OpenAI (só no servidor): IA de imagem do /admin e LEITURA AUTOMÁTICA das fotos de nota no financeiro
OPENAI_API_KEY=
# Modelo de visão usado para ler as notas (padrão gpt-4o-mini; barato). Troque só se a OpenAI aposentar o modelo.
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- Cadastro de usuários e backup (SOMENTE no servidor; nunca com NEXT_PUBLIC_) ---
# Supabase → Project Settings → API Keys → "service_role" (secret). Dá acesso total ao banco!
SUPABASE_SERVICE_ROLE_KEY=

# Backup semanal por e-mail. A chave do Resend pode ser cadastrada em /admin → Integrações (recomendado)
# ou aqui. resend.com, conta criada com o e-mail que vai receber.
RESEND_API_KEY=
BACKUP_EMAIL_TO=nortedronesto@gmail.com
# BACKUP_EMAIL_FROM="Norte Drones <onboarding@resend.dev>"

# Segredo que autoriza o agendamento da Vercel (qualquer texto longo e aleatório)
CRON_SECRET=
